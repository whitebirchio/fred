# Neon pooled connection string; unset = embedded PGlite for local dev
DATABASE_URL=
# External sync: monarch (default) | fixture (synthetic data, no token needed)
FRED_SYNC_PROVIDER=
# Monarch API credentials — mint both via `npm run monarch:login` (see docs/SYNC.md);
# required for FRED_SYNC_PROVIDER=monarch
MONARCH_TOKEN=
MONARCH_DEVICE_UUID=
# Cloudflare Access (production only — set as Worker secrets, not here).
# Listed for reference; see docs/AUTH.md.
#   CF_ACCESS_TEAM_DOMAIN=whitebirchsoftware
#   CF_ACCESS_AUD=<Audience tag from the Access application>
