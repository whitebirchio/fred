# Neon pooled connection string; unset = embedded PGlite for local dev
DATABASE_URL=postgresql://
# External sync: monarch (default) | fixture (synthetic data, no token needed)
FRED_SYNC_PROVIDER=monarch
# Monarch API credentials — fallback only. The running app reads its token
# from the database, refreshed via `npm run monarch:refresh` (see docs/SYNC.md);
# these only matter if you're constructing MonarchProvider directly (e.g.
# scripts/monarch_probe.ts) without a database-stored token.
MONARCH_TOKEN=
MONARCH_DEVICE_UUID=
# Where `npm run monarch:refresh` pushes a freshly-minted Monarch token.
# Defaults to the production URL baked into the script; only set this to point
# a refresh at somewhere else (e.g. localhost while testing the push itself).
FRED_APP_URL=https://fred.whitebirch.workers.dev
# Cloudflare Access service token — lets monarch:refresh push to the deployed
# (Access-gated) app non-interactively. One-time setup in docs/SYNC.md.
CF_ACCESS_SERVICE_CLIENT_ID=
CF_ACCESS_SERVICE_CLIENT_SECRET=
# Cloudflare Access (production only — set as Worker secrets, not here).
# Listed for reference; see docs/AUTH.md.
#   CF_ACCESS_TEAM_DOMAIN=whitebirchsoftware
#   CF_ACCESS_AUD=<Audience tag from the Access application>
