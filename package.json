{
  "name": "fred",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "node --env-file-if-exists=.env node_modules/.bin/drizzle-kit push",
    "db:seed": "node --env-file-if-exists=.env node_modules/.bin/tsx src/db/seed.ts",
    "icons": "node scripts/make-icons.mjs",
    "monarch:login": "node scripts/monarch-login.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "monarch:probe": "node --env-file=.env node_modules/.bin/tsx scripts/monarch_probe.ts",
    "sync:state": "node --env-file=.env node_modules/.bin/tsx scripts/db_state.ts",
    "sync:now": "node --env-file=.env node_modules/.bin/tsx scripts/sync_now.ts",
    "household:backfill": "node --env-file=.env node_modules/.bin/tsx scripts/backfill_household.ts",
    "verify:access": "node node_modules/.bin/tsx scripts/verify_access.ts",
    "verify:dbrole": "node node_modules/.bin/tsx scripts/verify_db_role.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@neondatabase/serverless": "^1.1.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.9.2"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "pg": "^8.22.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "wrangler": "^4.112.0"
  }
}
