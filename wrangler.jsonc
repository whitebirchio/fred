{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fred",
  "main": "worker.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "fred"
    }
  ],
  "observability": {
    "enabled": true
  },
  // Preview URLs (per-version URLs like <version>-fred.workers.dev) aren't
  // used here — deploys always go straight to the main URL — and Cloudflare
  // Access doesn't cover them by default (a separate hostname from the one
  // Access is configured for). worker.ts's own JWT check would still reject
  // them either way, but there's no reason to leave the extra surface on.
  "preview_urls": false
  // Secrets (set with `wrangler secret put <NAME>`):
  //   DATABASE_URL           — Neon pooled connection string
  //   CF_ACCESS_TEAM_DOMAIN  — e.g. "yourteam" (Zero Trust team name)
  //   CF_ACCESS_AUD          — the Access application's Audience tag
  // The two CF_ACCESS_* values are required: without them the Worker refuses
  // to serve anything. See docs/AUTH.md.
}
